<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <title>MindTrack • Journal</title>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand">MindTrack</div>
    <div class="nav-links">
      <a href="/journal">Journal</a>
      <a href="/journal/dashboard">Dashboard</a>
      <a href="/journal/calendar">Calendar</a>
      <a href="/logout">Log Out</a>
    </div>
  </nav>

  <main class="dashboard">
    <h1>Your Journal</h1>
    <p class="subtitle">Write and review your daily reflections.</p>

    <section class="auth-card" style="max-width:600px; margin:1rem auto;">
      <h2>New Entry</h2>
      <form method="POST" action="/journal">
        <textarea name="text" rows="4" placeholder="How are you feeling today?" required style="width:100%; padding:.75rem;"></textarea>
        <select name="rating" required style="width:100%; padding:.75rem; margin-top:.5rem;">
          <option value="">Rate your mood</option>
          <option value="5">5 - 😃</option>
          <option value="4">4 - 🙂</option>
          <option value="3">3 - 😐</option>
          <option value="2">2 - 🙁</option>
          <option value="1">1 - 😢</option>
        </select>
        <button type="submit">Save Entry</button>
      </form>
    </section>

    <section class="cards">
      <% entries.forEach(e => { %>
        <div class="card">
          <h3><%= e.date %> - Rating: <%= e.rating %>/5</h3>
          <p><%= e.text.slice(0, 100) %><%= e.text.length>100 ? '…' : '' %></p>
        </div>
      <% }) %>
      <% if (!entries.length) { %>
        <p style="text-align:center; width:100%;">No journal entries yet.</p>
      <% } %>
    </section>
  </main>

  <footer class="footer">
    Powered by MindTrack &bull; Your mental health companion
  </footer>
</body>
</html>
